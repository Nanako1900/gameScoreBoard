# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit the real .dev.vars.
# In production, set the secrets via:  wrangler secret put <NAME>

# --- Nanako OAuth (your own OAuth2 provider) ---
# Base URL in front of /oauth/authorize, /oauth/token, /oauth/userinfo
OAUTH_BASE_URL="https://auth.example.com"
OAUTH_CLIENT_ID="your-client-id"
OAUTH_CLIENT_SECRET="your-client-secret"

# --- Session signing key (HS256). Generate a long random string, e.g.:
#     openssl rand -base64 48
SESSION_SECRET="please-change-me-to-a-long-random-string"

# --- App config ---
# Optional. If unset, redirect_uri is derived from the incoming request origin.
# APP_URL="http://localhost:8787"

# Timezone offset (hours) used to compute the weekly reset boundary. 8 = Beijing.
RESET_TZ_OFFSET="8"

# Comma-separated OAuth subject ids (users.id) auto-granted admin on login.
# Once set, ADMIN_USERNAMES is ignored.
# ADMIN_SUBJECT_IDS=""
# Deprecated: comma-separated usernames auto-granted admin on login.
ADMIN_USERNAMES="Nanako1900"

# Maintenance mode: "1" refuses every write with 503 (used for the DB cutover).
# READ_ONLY="1"

# --- AI 裁决 -----------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI / DeepSeek / 硅基流动 / OpenRouter /
# vLLM / Ollama / your own gateway. Endpoint, model, API key, temperature,
# enabled switch and all three prompts are maintained at /admin/ai.
# Provider keys are stored only as AES-256-GCM ciphertext in app_settings.
# Generate a master ONCE: openssl rand -base64 32
# Persist and back it up separately from the DB; never regenerate on deploy.
# Node deployments: app + bot must receive the SAME AI_CONFIG_MASTER_KEY.
# Worker production: wrangler secret put AI_CONFIG_MASTER_KEY
AI_CONFIG_MASTER_KEY=""
# Legacy provider env defaults remain usable only before a credential row exists.
# After a web-set or explicitly cleared key, AI_API_KEY no longer takes effect.
AI_ENABLED="true"
AI_BASE_URL="https://api.openai.com/v1"   # must end at /v1 — the code appends /chat/completions
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
# AI_TEMPERATURE="0.2"                    # keep low: verdicts should be reproducible
# AI_SYSTEM_PROMPT="..."                  # empty = built-in prompt; edit it in the admin panel instead

# Hours the accused gets to explain before a case is judged in absentia.
# STATEMENT_WINDOW_HOURS="12"

# 'false' = a session organizer who is not a judge can only record attendance,
# never file cases (a judge then has to file them).
# SESSION_ORGANIZER_CAN_FILE="true"

# --- Split deployment only (frontend on a different origin, e.g. EdgeOne) -----
# Leave ALL of these unset for the single-origin setup (unified Worker, or the
# EdgeOne edge-function reverse-proxy = Option A). See DEPLOY-EDGEONE.md.
# FRONTEND_ORIGIN="https://your-app.edgeone.app"   # enables credentialed CORS (Option B/C)
# FRONTEND_URL="https://your-app.edgeone.app"      # where /auth/callback returns the browser
# COOKIE_SAMESITE="Lax"                            # 'None' for cross-site (Option C)
# COOKIE_DOMAIN=".example.com"                     # share cookie across subdomains (Option B)
