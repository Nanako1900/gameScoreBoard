{
  "name": "edg-credit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EDG 信誉分 — 仿王者荣耀信誉分的开黑守约计分板 (Cloudflare Workers + D1)",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev:web": "vite",
    "dev": "wrangler dev",
    "build": "vite build",
    "build:pages": "vite build && node scripts/pages-headers.mjs dist",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:dom && npm run test:worker && npm run test:server",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:local": "wrangler d1 execute edg-credit --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute edg-credit --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute edg-credit --local --file=./migrations/002_v2_cases_and_sessions.sql",
    "db:migrate:remote": "wrangler d1 execute edg-credit --remote --file=./migrations/002_v2_cases_and_sessions.sql",
    "cf-typegen": "wrangler types",
    "db:migrate3:local": "wrangler d1 execute edg-credit --local --file=./migrations/003_v3_quick_flows.sql",
    "db:migrate3:remote": "wrangler d1 execute edg-credit --remote --file=./migrations/003_v3_quick_flows.sql",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.107.0"
  }
}
